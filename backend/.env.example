# 后端环境变量示例（复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不入库）
FLASK_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173

# ===== MySQL 连接 =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=xiaobei_auto
DB_USER=root
DB_PASSWORD=your_password
# SQLAlchemy 连接串（驱动使用 PyMySQL），格式：mysql+pymysql://<user>:<password>@<host>:3306/<dbname>?charset=utf8mb4
SQLALCHEMY_DATABASE_URI=mysql+pymysql://<user>:<password>@<host>:3306/<dbname>?charset=utf8mb4
SQLALCHEMY_TRACK_MODIFICATIONS=False

# ===== JWT 凭证 =====
JWT_SECRET_KEY=please-change-this-secret
JWT_EXPIRES_HOURS=12

# ===== 定时任务调度器 =====
# [部署约束] 调度器全系统只允许单实例运行（见 app.py 头部说明），多 worker 部署会重复打卡；
# 横向扩容 Web 时将 Web 进程置 0，由独立常驻进程接管调度。
# SCHEDULER_ENABLED=1
# 并发签到线程池大小：多人同刻集中打卡时按峰值任务量调大（签到为网络 I/O，单进程可撑数百并发）
# SCHEDULER_MAX_WORKERS=30
# 错过触发时刻的补跑宽限秒数：线程池排队导致晚执行的任务在此窗口内照常补跑而非被丢弃
# SCHEDULER_MISFIRE_GRACE=600
# 启动对账同日补跑：仅补跑计划时刻在「当天」的错过任务（两类签到任务都只当天有效）；
# 计划时刻在昨天及更早的跨天任务不补跑，落 skip 说明并推进 next_run_at。置 0 恢复不限时补跑
# SCHEDULER_RECONCILE_SAME_DAY=1
# 调度时区
# SCHEDULER_TZ=Asia/Shanghai

# ===== 网络请求 TLS 校验（两套独立开关）=====
# 推送通道（Server酱 / PushPlus）：公共服务证书链完整，默认开启校验。
# 仅当部署机信任库确有缺陷（缺中间 CA 导致握手失败）时置 0 显式降级
# PUSH_VERIFY_SSL=1
# B 平台（校园服务器）：证书已失效，开启即无法通信，默认必须保持关闭
# BP_VERIFY_SSL=0
